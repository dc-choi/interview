  "scope": "Default lookup requests without conditions; existing synthetic regression questions, not a new quality holdout.",
  "runner_source": "import assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { pathToFileURL } from 'node:url';\nimport { createHash } from 'node:crypto';\nconst repo = '/Users/mark/myown/interview';\nconst source = join(repo, 'ontology/src');\nconst hash = value => createHash('sha256').update(value).digest('hex');\nconst { lookup: current } = await import(pathToFileURL(join(source, 'query.mjs')));\nconst { loadSnapshot } = await import(pathToFileURL(join(source, 'snapshot.mjs')));\nconst { DEFAULT_SCOPES } = await import(pathToFileURL(join(source, 'core.mjs')));\nconst previous = JSON.parse(fs.readFileSync(join(repo, 'ontology/evaluation/coverage-report-2026-09-08.json')));\nconst caseFiles = Object.keys(previous.inputs.case_files);\nconst cases = caseFiles.flatMap(file => JSON.parse(fs.readFileSync(join(repo, file))));\nconst temporary = fs.mkdtempSync(join(tmpdir(), 'ontology-default-regression-'));\ntry {\n  const baseline = fs.readFileSync('/tmp/ontology-query-before-sufficiency-2026-09-08.mjs');\n  fs.writeFileSync(join(temporary, 'query.mjs'), baseline);\n  for (const file of ['core.mjs', 'repository.mjs', 'snapshot.mjs', 'markdown.mjs']) fs.symlinkSync(join(source, file), join(temporary, file));\n  const { lookup: before } = await import(pathToFileURL(join(temporary, 'query.mjs')));\n  const snapshot = loadSnapshot({ repo });\n  const codeHashes = Object.fromEntries(['query.mjs', 'core.mjs', 'repository.mjs', 'snapshot.mjs', 'markdown.mjs'].map(file => [file, hash(fs.readFileSync(join(source, file)))]));\n  const results = [];\n  for (const sample of cases) {\n    const args = { query: sample.query, scope: sample.scope ?? DEFAULT_SCOPES, max_bytes: sample.max_bytes ?? 24000 };\n    const options = { repo, allowlist: DEFAULT_SCOPES };\n    const a = before(options, args, snapshot);\n    const b = current(options, args, snapshot);\n    assert.deepEqual(b, a, sample.id);\n    assert.equal(Buffer.byteLength(JSON.stringify(b)), b.budget.used_bytes, sample.id);\n    results.push({ id: sample.id, equal: true, response_sha256: hash(JSON.stringify(b)), bytes: b.budget.used_bytes });\n  }\n  for (const [file, sha] of Object.entries(codeHashes)) assert.equal(hash(fs.readFileSync(join(source, file))), sha, file);\n  const report = { kind: 'existing-question-response-equivalence', source_revision: snapshot.manifest.revision,\n    fingerprint: snapshot.fingerprint, manifest_hash: snapshot.manifest_hash, baseline_query_sha256: hash(baseline),\n    code_sha256: codeHashes, case_sha256: Object.fromEntries(caseFiles.map(file => [file, hash(fs.readFileSync(join(repo, file)))])),\n    cases: results.length, exact_json_equivalence: true, results };\n  fs.writeFileSync('/tmp/ontology-default-regression-2026-09-08.json', JSON.stringify(report, null, 2) + '\\n');\n  console.log(JSON.stringify({ cases: results.length, exact_json_equivalence: true, report: '/tmp/ontology-default-regression-2026-09-08.json' }));\n} finally { fs.rmSync(temporary, { recursive: true, force: true }); }\n"
